% Build a cascade (row vector) of RF elements
elements(1) = rfantenna( ...
    'Name','Antenna_DirectNewton', ...
    'Type','Receiver', ...
    'Gain',34, ...
    'Z',75);%, ...
    %'TxEIRP',92.16, ...
    %'PathLoss',226.7
elements(2) = rffilter( ...
    'FilterType','Butterworth', ...
    'ResponseType','Bandpass', ...
    'Implementation','LC Tee', ...
    'FilterOrder',3, ...
    'PassbandFrequency',[176 182]*1e6, ...
    'PassbandAttenuation',1, ...
    'Zin',75, ...
    'Zout',75, ...
    'Name','RFFilter');
elements(3) = amplifier( ...
    Name='RFAmplifier', ...
    Gain=32, ...
    NF=2.5, ...
    OIP3=45, ...
    Zin=75, ...
    Zout=75, ...
    Model='cubic');
elements(4) = modulator( ...
    Name='Demodulator', ...
    Zin=75, ...
    Zout=75, ...
    Model='demod', ...
    LO=2e9);
elements(5) = rffilter( ...
    'FilterType','Butterworth', ...
    'ResponseType','Bandpass', ...
    'Implementation','LC Tee', ...
    'FilterOrder',3, ...
    'PassbandFrequency',[50 90]*1e6, ...
    'PassbandAttenuation',2.9, ...
    'Zin',75, ...
    'Zout',75, ...
    'Name','IFFilter');
elements(6) = amplifier( ...
    Name='IFAmplifier', ...
    Gain=25, ...
    NF=3, ...
    OIP3=40, ...
    Zin=75, ...
    Zout=75, ...
    Model='cubic');

% Construct an rfbudget object
b = rfbudget( ...
    Elements=elements, ...
    InputFrequency=179e6, ...
    AvailableInputPower=-65, ...
    SignalBandwidth=6e6, ...
    Solver='Friis', ...
    AutoUpdate=true);

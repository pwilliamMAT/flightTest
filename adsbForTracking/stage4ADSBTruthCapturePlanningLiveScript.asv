%[text] # Stage 4A ADS-B Truth Capture Planning
%[text] Stage 4A is not a retraining stage. It turns the Stage 3B data-readiness gaps into five review plots that answer what ADS-B truth must be collected next. The source data is still the saved Stage 3B artifact; the new work here is planning and visualization.
projectRoot = fileparts(mfilename("fullpath"));
addpath(projectRoot);

if ~exist("stage4OutputFolder", "var")
    stage4OutputFolder = fullfile(projectRoot, "artifacts", "stage4A");
end

stage4Plan = helperBuildStage4ADSBTruthCapturePlan("ProjectRoot", projectRoot);
%%
%[text] ## Native Function Audit
%[text] This checkpoint stays MATLAB-native: it loads the saved Stage 3B MAT artifact with |load|, keeps Stage 3B's native |constvel| comparator results, groups split coverage with |findgroups| and |splitapply|, and renders the review with |figure|, |tiledlayout|, |bar|, |barh|, |imagesc|, and standard axis labels. No new ADS-B parser, neural retraining, or custom motion model is introduced.
nativeWorkflowReference = [ ...
    "load Stage 3B artifact"; ...
    "summarize readiness gates"; ...
    "compare constvel and frozen MLP RMSE"; ...
    "plot split coverage"; ...
    "plot ADS-B-only capture progress"];
%%
%[text] ## Question 1: Are We Ready To Retrain?
%[text] The readiness plot compares the current Stage 3B observations with the existing minimum gate and the larger Stage 4A capture-campaign target. Failed gates are marked directly on the plot.
stage4ReadinessFigure = helperPlotStage4ADSBTruthCapturePlan( ... %[output:group:12e001f3] %[output:9cef4521]
    stage4Plan, ... %[output:9cef4521]
    "PlotName", ... %[output:9cef4521]
    "readinessGates", ... %[output:9cef4521]
    "OutputFolder", ... %[output:9cef4521]
    stage4OutputFolder, ... %[output:9cef4521]
    "SaveFigures", ... %[output:9cef4521]
    true); %[output:group:12e001f3] %[output:9cef4521]
stage4MinimumGateShortfall = stage4Plan.summary.minimumGateShortfall;
%%
%[text] ## Question 2: What Motion Regimes Are Missing?
%[text] The motion plot shows the current pair counts by motion and update regime. A useful retraining set needs more than straight, regular-update flight; the collection plan specifically needs more turn-like and sparse-update examples.
stage4MotionCoverageFigure = helperPlotStage4ADSBTruthCapturePlan( ... %[output:group:03e4b13c] %[output:15f92424]
    stage4Plan, ... %[output:15f92424]
    "PlotName", ... %[output:15f92424]
    "motionCoverage", ... %[output:15f92424]
    "OutputFolder", ... %[output:15f92424]
    stage4OutputFolder, ... %[output:15f92424]
    "SaveFigures", ... %[output:15f92424]
    true); %[output:group:03e4b13c] %[output:15f92424]
%%
%[text] ## Question 3: Did Stage 3 Show A Model Problem Or A Data Problem?
%[text] Stage 3B showed both: the frozen MLP is worse than |constvel| on the same rows, and the rows are not representative enough for a retraining claim. The grouped RMSE plot keeps those two facts connected by regime.
stage4ModelDataFigure = helperPlotStage4ADSBTruthCapturePlan( ... %[output:group:1fb3db2a] %[output:78e086ef]
    stage4Plan, ... %[output:78e086ef]
    "PlotName", ... %[output:78e086ef]
    "modelDataProblem", ... %[output:78e086ef]
    "OutputFolder", ... %[output:78e086ef]
    stage4OutputFolder, ... %[output:78e086ef]
    "SaveFigures", ... %[output:78e086ef]
    true); %[output:group:1fb3db2a] %[output:78e086ef]
%%
%[text] ## Question 4: Can Validation And Test Splits Evaluate Generalized Motion?
%[text] The split-coverage plot makes missing evaluation coverage visible. In the current artifact, turn-like examples do not appear outside training, so validation and test cannot judge turn generalization.
stage4SplitCoverageFigure = helperPlotStage4ADSBTruthCapturePlan( ... %[output:group:907a3f26] %[output:0c8dabcb]
    stage4Plan, ... %[output:0c8dabcb]
    "PlotName", ... %[output:0c8dabcb]
    "splitCoverage", ... %[output:0c8dabcb]
    "OutputFolder", ... %[output:0c8dabcb]
    stage4OutputFolder, ... %[output:0c8dabcb]
    "SaveFigures", ... %[output:0c8dabcb]
    true); %[output:group:907a3f26] %[output:0c8dabcb]
%%
%[text] ## Question 5: What Should The ADS-B-Only Capture Campaign Target?
%[text] The campaign plot uses the accepted ADS-B-only logger command and the discoverable packaged truth folder layout. These captures should add sessions, truth files, aircraft tracks, turn-like pairs, and sparse-update pairs before any serious retraining starts.
stage4CaptureCampaignFigure = helperPlotStage4ADSBTruthCapturePlan( ... %[output:group:9027eac1] %[output:4ba51906]
    stage4Plan, ... %[output:4ba51906]
    "PlotName", ... %[output:4ba51906]
    "captureCampaign", ... %[output:4ba51906]
    "OutputFolder", ... %[output:4ba51906]
    stage4OutputFolder, ... %[output:4ba51906]
    "SaveFigures", ... %[output:4ba51906]
    true); %[output:group:9027eac1] %[output:4ba51906]
stage4CaptureCommandTemplate = stage4Plan.captureCommandTemplate;
stage4TruthFolderLayout = stage4Plan.truthFolderLayout;
%%
%[text] ## Current Decision
%[text] Stage 4A keeps the Stage 3A MLP frozen and treats Stage 3B as a data-gap diagnostic. The next concrete action is ADS-B-only truth capture, not model tuning.
stage4Decision = stage4Plan.summary.decision;
stage4RecommendedShortfall = stage4Plan.summary.recommendedCaptureShortfall;

